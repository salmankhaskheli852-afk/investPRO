
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is a super admin by email
    // or if their UID exists in the admin roles collection.
    function isAdmin() {
      return request.auth != null && 
             (
                request.auth.token.email == 'salmankhaskheli885@gmail.com' ||
                request.auth.token.email == 'salmankhaskheli852@gmail.com' ||
                exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
                (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
             );
    }

    // Helper function to check if the user is an agent by their role document.
    function isAgent() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }
    
    // --- Global Admin Access ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Agent Rules ---
    match /{collection}/{docId} {
      allow read, write, list: if isAgent() && 
                                 collection in ['users', 'investment_plans', 'plan_categories', 'transactions', 'admin_wallets', 'withdrawal_methods', 'password_reset_requests', 'image_library'];
    }
    
    // Allow agents to manage user subcollections
    match /users/{userId}/{document=**} {
        allow read, write: if isAgent();
    }

    // --- Regular User Rules ---
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isUserAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isUserAuthenticated();
      allow create: if request.auth != null;
      allow update: if isOwner(userId);
    }
    
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /investment_plans/{planId} {
        allow read: if true;
        allow update: if isUserAuthenticated();
    }

    match /plan_categories/{categoryId} {
        allow read: if true;
    }
    
    match /admin_wallets/{walletId} {
        allow read: if isUserAuthenticated();
    }

    match /withdrawal_methods/{methodId} {
      allow read: if isUserAuthenticated();
    }

    match /app_config/{setting} {
      allow get: if true;
    }
    
    match /password_reset_requests/{requestId} {
        allow create: if isUserAuthenticated();
    }

    // Explicitly allow admins and agents to list transactions, while users only see their own
    match /transactions/{transactionId} {
      allow create: if isUserAuthenticated();
      allow read, list: if isAdmin() || isAgent() || (isUserAuthenticated() && resource.data.details.userId == request.auth.uid);
    }
    
    match /referral_requests/{requestId} {
        allow create: if isUserAuthenticated();
        allow read, update: if isUserAuthenticated() && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.targetId);
    }
  }
}
