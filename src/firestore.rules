rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is a super admin or has been granted admin role
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() in ['salmankhaskheli885@gmail.com', 'salmankhaskheli852@gmail.com']) ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function to check if the user is an agent
    function isAgent() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }
    
    // MASTER RULE: TOTAL PERMISSION FOR ALL ADMINS
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Agent Rules: Allow access to managed collections
    match /{collection}/{docId} {
      allow read, write, list: if isAgent() && 
                                 collection in ['users', 'investment_plans', 'plan_categories', 'transactions', 'admin_wallets', 'withdrawal_methods', 'password_reset_requests', 'image_library'];
    }

    // Authenticated User Rules
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if isAdmin() || isAgent();
      allow create: if request.auth != null;
      allow update: if isOwner(userId) || isAdmin();
    }
    
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAgent() || isAdmin();
    }

    // Transactions Rules
    match /transactions/{transactionId} {
      allow create: if request.auth != null;
      // Allow users to list ONLY their own transactions in the root collection
      // Standard users can query with a userId filter, Admins/Agents can query everything
      allow read, list: if isAdmin() || isAgent() || (request.auth != null && resource.data.details.userId == request.auth.uid);
    }

    // Image Library
    match /image_library/{imgId} {
        allow read: if request.auth != null;
        allow write: if isAdmin() || isAgent();
    }

    // Investment Plans & Categories
    match /investment_plans/{planId} {
        allow read: if true;
        allow update: if request.auth != null;
        allow create, delete: if isAdmin() || isAgent();
    }

    match /plan_categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isAgent();
    }
    
    // Wallets & Config
    match /admin_wallets/{walletId} {
        allow read: if request.auth != null;
    }

    match /withdrawal_methods/{methodId} {
      allow read: if request.auth != null;
    }

    match /app_config/{setting} {
      allow get: if true;
    }
    
    match /password_reset_requests/{requestId} {
        allow create: if request.auth != null;
        allow read, write: if isAdmin() || isAgent();
    }
    
    match /referral_requests/{requestId} {
        allow create: if request.auth != null;
        allow read, update: if request.auth != null && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.targetId);
    }
  }
}